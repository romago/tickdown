# Root-level .env used by docker-compose
# Generate a strong JWT_SECRET, e.g.: openssl rand -hex 32
JWT_SECRET=replace_with_output_of_openssl_rand_hex_32
# MongoDB root password, used by both the mongo and backend containers.
# Only applied when the mongo volume is created; changing it later needs the password changed in MongoDB too.
MONGO_PASSWORD=replace_with_a_long_random_password
