# Root-level .env used by docker-compose
# Generate a strong JWT_SECRET, e.g.: openssl rand -hex 32
JWT_SECRET=replace_with_output_of_openssl_rand_hex_32
# MongoDB root password, used by both the mongo and backend containers.
# Only applied when the mongo volume is created; changing it later needs the password changed in MongoDB too.
MONGO_PASSWORD=replace_with_a_long_random_password
# Optional, default tickdown. An install from before the rename keeps MONGO_USER=checkmate and MONGO_DB=checkmate.
# MONGO_USER=tickdown
# MONGO_DB=tickdown

# Optional
# API_PORT=5010            # host port for the API (127.0.0.1 only)
# WEB_PORT=3010            # host port for the dev web server
# ALLOW_REGISTRATION=false # close sign-up, e.g. on a public demo
# DEMO_EMAIL=demo@tickdown.app  # this account cannot change its password
